{
    "compilerOptions": {
        "target": "ES2022",
        "lib": ["DOM", "ES2022"],
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "jsx": "react-jsx",
        "strict": true,
        "skipLibCheck": true,
        "declaration": true,
        "declarationDir": "dist",
        "emitDeclarationOnly": false,
        "rootDir": "src",
        "verbatimModuleSyntax": true
    },
    "include": ["src/**/*"]
}
