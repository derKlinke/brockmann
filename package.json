{
    "name": "@derklinke/brockmann",
    "version": "1.4.0",
    "description": "Shared typography and grid system for klinke.studio",
    "repository": {
        "type": "git",
        "url": "https://github.com/derKlinke/brockmann.git"
    },
    "license": "MIT",
    "type": "module",
    "exports": {
        ".": "./src/index.ts",
        "./rehype": "./src/rehype/typo-classes.ts",
        "./styles/tokens.css": "./styles/tokens.css",
        "./styles/spacing.css": "./styles/spacing.css",
        "./styles/core.css": "./styles/core.css",
        "./styles/grid.css": "./styles/grid.css",
        "./styles/presets/site.css": "./styles/presets/site.css",
        "./styles/presets/helvetica.css": "./styles/presets/helvetica.css"
    },
    "files": [
        "dist",
        "README.md",
        "LICENSE",
        "CHANGELOG.md"
    ],
    "scripts": {
        "clean": "rm -rf dist",
        "build:js": "esbuild src/index.ts --bundle --format=esm --platform=neutral --outfile=dist/index.js --external:react && esbuild src/rehype/typo-classes.ts --bundle --format=esm --platform=node --outfile=dist/rehype.js",
        "build:types": "tsc -p tsconfig.json --emitDeclarationOnly",
        "generate:presets": "node scripts/generate-presets.mjs",
        "build:css": "npm run generate:presets && mkdir -p dist/styles/presets && cp styles/*.css dist/styles/ && cp styles/presets/site.css dist/styles/presets/site.css && cp styles/presets/helvetica.css dist/styles/presets/helvetica.css",
        "build:package": "node scripts/prepare-dist-package.mjs",
        "build": "npm run clean && npm run build:types && npm run build:js && npm run build:css && npm run build:package",
        "typecheck": "tsc -p tsconfig.json --noEmit",
        "test": "npm run build && node --test tests/**/*.test.mjs",
        "pack:check": "npm run build && npm pack ./dist --dry-run"
    },
    "engines": {
        "node": ">=22"
    },
    "publishConfig": {
        "access": "public"
    },
    "peerDependencies": {
        "react": "^19.0.0"
    },
    "devDependencies": {
        "@semantic-release/changelog": "^6.0.3",
        "@semantic-release/commit-analyzer": "^13.0.1",
        "@semantic-release/exec": "^7.1.0",
        "@semantic-release/git": "^10.0.1",
        "@semantic-release/github": "^12.0.6",
        "@semantic-release/release-notes-generator": "^14.1.0",
        "@types/node": "^25.5.0",
        "@types/react": "^19.2.14",
        "@types/react-dom": "^19.2.3",
        "esbuild": "^0.27.4",
        "react": "^19.2.4",
        "react-dom": "^19.2.4",
        "semantic-release": "^25.0.3",
        "typescript": "^5.9.3"
    }
}
